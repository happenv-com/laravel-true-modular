{
    "name": "happenv-com/laravel-true-modular",
    "license": "MIT",
    "type": "library",
    "authors": [
        {
            "name": "webard",
            "email": "code@webard.me"
        }
    ],
    "require": {
        "php": "^8.3",
        "laravel/framework": "^12.0 || ^13.0",
        "thecodingmachine/safe": "^3.0"
    },
    "require-dev": {
        "webard/laravel-access-control": "^1.0",
        "ergebnis/composer-normalize": "^2.48",
        "laravel/pint": "^1.29",
        "orchestra/testbench": "^11.1",
        "pestphp/pest": "^4.0",
        "thecodingmachine/phpstan-safe-rule": "^1.2",
        "rector/rector": "^2.5",
        "larastan/larastan": "^3.10",
        "livewire/livewire": "^3.0"
    },
    "suggest": {
        "webard/laravel-access-control": ""
    },
    "minimum-stability": "stable",
    "autoload": {
        "psr-4": {
            "Happenv\\LaravelTrueModular\\": "src/"
        },
        "files": [
            "src/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Happenv\\LaravelTrueModular\\Tests\\": "tests/"
        },
        "classmap": [
            "tests/fixtures/app-modules"
        ]
    },
    "config": {
        "allow-plugins": {
            "ergebnis/composer-normalize": true,
            "pestphp/pest-plugin": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Happenv\\LaravelTrueModular\\KernelServiceProvider"
            ]
        }
    },
    "$schema": "https://getcomposer.org/schema.json"
}
