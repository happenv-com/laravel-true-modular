# Path-based git attributes
# https://git-scm.com/docs/gitattributes
* text=auto eol=lf
*.blade.php diff=html
*.css       diff=css
*.html      diff=html
*.md        diff=markdown
*.php       diff=php
*.png       binary
*.jpg       binary
*.gif       binary

# Everything below stays out of the archive Composer installs.
# Ships on purpose:
#   /docs - Laravel Boost guidelines point consumers at vendor/.../docs

# Repository metadata
/.gitattributes         export-ignore
/.gitignore             export-ignore
/.github                export-ignore
/.editorconfig          export-ignore
/.idea                  export-ignore
/.vscode                export-ignore
/moat.toml              export-ignore
.DS_Store               export-ignore

# Agent / assistant files
/.claude                export-ignore
/.serena                export-ignore
/AGENTS.md              export-ignore
/CLAUDE.md              export-ignore

# Docs & media not needed at runtime
/art                    export-ignore
/images                 export-ignore
/screenshots            export-ignore
/screens                export-ignore
/CHANGELOG.md           export-ignore
/CONTRIBUTING.md        export-ignore
/SECURITY.md            export-ignore
/UPGRADING.md           export-ignore
/TODO.md                export-ignore
/DEMO.md                export-ignore

# Tests & QA tooling
/tests                  export-ignore
/workbench              export-ignore
/benchmarks             export-ignore
/build                  export-ignore
/testbench.yaml         export-ignore
/phpunit.xml            export-ignore
/phpunit.xml.dist       export-ignore
/phpstan.neon           export-ignore
/phpstan.neon.dist      export-ignore
/phpstan-baseline.neon  export-ignore
/pint.json              export-ignore
/rector.php             export-ignore
/docker-compose.yml     export-ignore
/composer.lock          export-ignore

# Front-end toolchain (resources/dist ships)
/bin                    export-ignore
/scripts                export-ignore
/node_modules           export-ignore
/package.json           export-ignore
/package-lock.json      export-ignore
/.npmrc                 export-ignore
/.nvmrc                 export-ignore
/.prettierrc            export-ignore
/.prettierignore        export-ignore
/vite.config.js         export-ignore
/postcss.config.js      export-ignore
/tailwind.config.js     export-ignore
/tsconfig.json          export-ignore

# Package-specific
/structarmed.php        export-ignore
